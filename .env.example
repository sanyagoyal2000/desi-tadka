# Copy to .env.local (never committed) and fill in ONE of the two modes.

# "codex" = use the Codex CLI already logged in on this machine (no API key, no image generation)
# "api"   = use the OpenAI API with your key (adds AI-generated pictures after swaps)
AI_MODE=codex

# Codex mode: full path to the codex binary, e.g. the one bundled with the ChatGPT desktop app
CODEX_PATH=/Applications/ChatGPT.app/Contents/Resources/codex
# Optional: override the Codex model / reasoning effort (low is faster)
CODEX_MODEL=
CODEX_REASONING=low

# API mode: check current model names at https://platform.openai.com/docs/models
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=

# Optional: if Instagram blocks a reel, let yt-dlp use your logged-in browser cookies (e.g. chrome, safari)
YTDLP_COOKIES_BROWSER=
