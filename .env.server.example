# Copy to .env ON THE SERVER (never commit it): cp .env.server.example .env && nano .env

# Your server's public IP with dashes + .sslip.io, e.g. 140-238-12-34.sslip.io
# (a free name that points at your IP, so Caddy can get an HTTPS certificate)
SITE_ADDRESS=

# Anyone opening the site must enter this once per phone/browser. Pick something long.
ACCESS_CODE=

# The server can't use the Codex app on your laptop, so it uses the OpenAI API.
AI_MODE=api
OPENAI_API_KEY=
# Check current model names at https://platform.openai.com/docs/models (pick one that reads images)
OPENAI_MODEL=
# Leave empty to skip AI pictures after swaps (cheaper). Fill in to turn them on.
OPENAI_IMAGE_MODEL=

# Optional: if Instagram blocks the server, export your Instagram cookies to secrets/cookies.txt
# (see DEPLOY.md) and uncomment:
# YTDLP_COOKIES_FILE=/app/secrets/cookies.txt
